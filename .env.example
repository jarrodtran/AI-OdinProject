# Copy to .env.local for local development. Everything here is optional:
# without these, the site works fully and progress is saved in the browser only.

# --- Cloud sync sign-in (Auth.js) ---
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Only needed when self-hosting with `next start` (Vercel trusts its own host).
# AUTH_TRUST_HOST=true

# GitHub OAuth app: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Progress storage ---
# Upstash Redis (added automatically by the Vercel Marketplace integration).
# Required in production. In development, a local .data/progress.json file is used instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Site ---
# Canonical origin for metadata and sitemap. Defaults to the Vercel production URL.
# NEXT_PUBLIC_SITE_URL=https://ai-odin-project.vercel.app
